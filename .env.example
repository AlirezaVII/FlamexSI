# Copy to .env and fill in. Never commit .env.

# AI provider: "gemini" or "mock" (mock needs no key; used in tests/CI)
FALMEX_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Where the backend keeps its data (raw files, parquet, duckdb). Default: <repo>/data
# FALMEX_DATA_DIR=/absolute/path/to/data

# Frontend -> backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
